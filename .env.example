# ===========================================================================
# ProITbridge — environment template.
#
# Copy to `.env` and fill in real values locally:  cp .env.example .env
# `.env` is gitignored. NEVER commit a real secret to any file (FR-SEC-12).
# The values below are safe placeholders / local-dev defaults only.
# ===========================================================================

# --- Database (matches docker-compose.yml for local dev) -------------------
# Two connections implement FR-SEC-11 (least-privilege app account):
#   DATABASE_URL -> restricted runtime role: no schema-alter rights, and UPDATE/DELETE
#                   revoked on audit_trail & super_admin_activity. Used by app + Prisma Client.
#   DIRECT_URL   -> owner/superuser used ONLY by `prisma migrate` to apply DDL and grants.
DATABASE_URL="postgresql://proitbridge_app:proitbridge_local_dev@localhost:5432/proitbridge?schema=public"
DIRECT_URL="postgresql://proitbridge_owner:proitbridge_local_dev@localhost:5432/proitbridge?schema=public"

# --- Auth / sessions -------------------------------------------------------
# Generate a strong value:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-secret"
APP_URL="http://localhost:3000"
SESSION_TIMEOUT_MINUTES="30"
SUPERADMIN_SESSION_TIMEOUT_MINUTES="15"

# --- Object storage: payment proofs (S3-compatible / MinIO) ----------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="proitbridge-proofs"
S3_ACCESS_KEY_ID="proitbridge"
S3_SECRET_ACCESS_KEY="proitbridge_local_dev"
S3_FORCE_PATH_STYLE="true"

# Proof storage provider: local filesystem for dev (MinIO/S3 wired in Phase 12).
# One of: local | s3
STORAGE_PROVIDER="local"
PROOF_STORAGE_DIR=".proof-storage"
# Signs short-lived proof URLs; falls back to AUTH_SECRET if unset.
PROOF_SIGNING_SECRET=""

# --- OCR provider (payment-proof extraction) -------------------------------
# One of:
#   vision = PDFs via unpdf text-layer + images via Google Cloud Vision (best accuracy).
#            Falls back to on-device OCR when OCR_API_KEY is empty.
#   local  = on-device only, no key: unpdf (PDF) + tesseract.js (images).
#   mock   = deterministic, reads only text embedded in a file (tests / offline CI).
OCR_PROVIDER="vision"
#
# To enable cloud OCR for screenshots, set OCR_API_KEY to a Google Cloud Vision API key:
#   1. https://console.cloud.google.com  → create/pick a project, enable billing.
#   2. APIs & Services → Library → enable "Cloud Vision API".
#   3. APIs & Services → Credentials → Create credentials → API key. Copy it.
#   4. (Recommended) Restrict the key to the Cloud Vision API only.
#   5. Paste it below and restart. Pricing: first 1,000 images/month free, then ~$1.50/1,000.
OCR_API_KEY=""

# --- Email / notifications -------------------------------------------------
# One of: console | <real provider>   (real provider wired in Phase 10)
EMAIL_PROVIDER="console"
EMAIL_API_KEY=""
EMAIL_FROM="no-reply@proitbridge.local"

# --- Seed passwords (dev only; used by prisma/seed.ts in Phase 1) ----------
# Seed users are created with must_change_password = true.
SEED_DEFAULT_PASSWORD="ChangeMe#123"
